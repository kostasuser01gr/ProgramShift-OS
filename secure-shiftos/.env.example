# Company IT must configure an Entra ID single-tenant app registration.
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Verified immutable Microsoft Entra object IDs; NEVER emails or a shared station account.
MANAGER_OIDS=
EDITOR_OIDS=
# Optional explicitly blocked object IDs in addition to built-in station check.
# Mandatory: the Entra object ID of the shared Heraklion station identity.
BLOCKED_OIDS=
# Private corporate SharePoint site and two custom lists (not OneDrive of the station).
SHAREPOINT_SITE_ID=
SHAREPOINT_EMPLOYEES_LIST_ID=
SHAREPOINT_SHIFTS_LIST_ID=
SHAREPOINT_PERIODS_LIST_ID=

# Required production release gates. Keep unset until verified by corporate IT.
IT_APPROVED=false
HOSTING_APPROVED=false
PRIVATE_ACL_REVIEWED=false

# Security Center read-only inspection. IDs are supplied securely by corporate IT.
EXCEL_DRIVE_ID=
EXCEL_FILE_ITEM_ID=
EXCEL_PARENT_ITEM_ID=
